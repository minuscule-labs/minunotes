{
  "name": "minunotes",
  "version": "1.6.1",
  "type": "module",
  "packageManager": "pnpm@8.15.3",
  "scripts": {
    "dev": "ENVIRONMENT=local TURSO_DB_URL=file:$PWD/local.db sst dev --mode=mono",
    "dev:sst": "ENVIRONMENT=local TURSO_DB_URL=file:$PWD/local.db sst dev",
    "dev:web": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "vite build",
    "deploy": "sst deploy",
    "deploy:dev": "ENVIRONMENT=development sst deploy --stage dev",
    "deploy:production": "ENVIRONMENT=production sst deploy --stage production",
    "release:dev": "tsx scripts/release.ts dev",
    "release:production": "tsx scripts/release.ts production",
    "remove": "sst remove",
    "remove:dev": "ENVIRONMENT=development sst remove --stage dev",
    "remove:production": "ENVIRONMENT=production sst remove --stage production",
    "down:dev": "tsx scripts/down.ts dev",
    "down:production": "tsx scripts/down.ts production",
    "email:test": "ENVIRONMENT=local tsx scripts/send-test-email.ts",
    "email-protection:verify": "ENVIRONMENT=local tsx scripts/verify-email-protection.ts",
    "docs:validate": "tsx scripts/validate-public-docs.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "ci:local": "pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:dev": "ENVIRONMENT=development tsx scripts/migrate.ts",
    "db:migrate:production": "ENVIRONMENT=production tsx scripts/migrate.ts",
    "db:verify-permissions": "tsx scripts/verify-permission-migration.ts",
    "db:verify-tenants": "tsx scripts/verify-tenant-integrity.ts",
    "db:wipe:dev": "ENVIRONMENT=development tsx scripts/wipe-db.ts --yes",
    "db:studio": "drizzle-kit studio",
    "attachments:cleanup": "tsx scripts/cleanup-attachments.ts",
    "benchmark:search": "tsx scripts/benchmark-search.ts",
    "benchmark:graph": "tsx scripts/benchmark-graph-discovery.ts",
    "prototype:search-fts": "tsx scripts/prototype-search-fts.ts",
    "search-index:rebuild": "tsx scripts/rebuild-search-index.ts",
    "export:mcp": "tsx scripts/export-mcp-package.ts",
    "oauth:smoke": "tsx scripts/oauth-smoke.ts",
    "postman:generate": "tsx scripts/generate-postman-collection.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1057.0",
    "@aws-sdk/client-sesv2": "^3.1057.0",
    "@aws-sdk/s3-request-presigner": "^3.1057.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/legacy-modes": "^6.5.3",
    "@dpklabs/minucanvas": "github:spdydve/minucanvas#v0.8.0",
    "@dpklabs/minueditor": "github:spdydve/minueditor#v0.16.2",
    "@hono/node-server": "^2.0.3",
    "@lezer/markdown": "^1.7.2",
    "@libsql/client": "latest",
    "@minunotes/email-protection": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-form": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-table": "latest",
    "better-auth": "^1.6.11",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "drizzle-orm": "latest",
    "emoji-picker-react": "^4.19.1",
    "emoji-regex": "^10.6.0",
    "hono": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "sst": "4.14.3",
    "tailwind-merge": "latest",
    "tldts": "^7.4.10"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "latest",
    "@types/aws-lambda": "8.10.161",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "drizzle-kit": "latest",
    "gray-matter": "^4.0.3",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "tailwindcss": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "^4.1.7"
  }
}
